{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🔧 Step 1: Build Manifest",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/build_manifest_v2.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "📚 Step 2: Prepare Vocab",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/prepare_vocab.py",
            "cwd": "${workspaceFolder}",
            "args": ["--target", "text_dialect"],
            "console": "integratedTerminal"
        },
        {
            "name": "🏋️ Step 3a: Sanity Check (5 epochs)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_wav2vec2.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--skip_augmented",
                "--epochs", "5",
                "--batch_size", "4",
                "--eval_steps", "50",
                "--save_steps", "50",
                "--output_dir", "models/sanity-check"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🏋️ Step 3b: Full Training (30 epochs)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_wav2vec2.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--base_model", "airesearch/wav2vec2-large-xlsr-53-th",
                "--target", "text_dialect",
                "--epochs", "30",
                "--batch_size", "4",
                "--gradient_accumulation_steps", "4",
                "--lr", "3e-4",
                "--warmup_steps", "500",
                "--eval_steps", "200",
                "--save_steps", "200",
                "--output_dir", "models/wav2vec2-south-th-v2"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🎤 Step 4: Test Inference (เลือกไฟล์)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/inference.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--model", "models/wav2vec2-south-th-v2",
                "--translate",
                "${input:wavFilePath}"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "📦 Step 5: Export Model (zip)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/export_model.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--model_dir", "models/wav2vec2-south-th-v2"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "📦 Step 5: Export Model (no zip)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/export_model.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--model_dir", "models/wav2vec2-south-th-v2",
                "--no_zip"
            ],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "wavFilePath",
            "type": "promptString",
            "description": "Path ไฟล์ .wav (เช่น audio_data/south/voice_1/voice_1_1.wav)",
            "default": "audio_data/south/voice_1/voice_1_1.wav"
        }
    ]
}
