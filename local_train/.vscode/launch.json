{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🔧 Step 0 (optional): Fix Audio (resample + rename)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/fix_audio.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "🔍 Step 0 (optional): Fix Audio — DRY RUN",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/fix_audio.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--dry_run"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🔧 Step 1: Build Manifest",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/build_manifest_v2.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "📚 Step 2: Prepare Vocab",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/prepare_vocab.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--target",
                "text_dialect"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🏋️ Step 3a: Sanity Check (5 epochs, original split)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_wav2vec2.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--skip_augmented",
                "--epochs",
                "5",
                "--batch_size",
                "4",
                "--eval_steps",
                "50",
                "--save_steps",
                "50",
                "--output_dir",
                "models/sanity-check"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🏋️ Step 3b: Full Training (30 epochs)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_wav2vec2.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--base_model",
                "airesearch/wav2vec2-large-xlsr-53-th",
                "--target",
                "text_dialect",
                "--epochs",
                "30",
                "--batch_size",
                "4",
                "--gradient_accumulation_steps",
                "4",
                "--lr",
                "3e-4",
                "--warmup_steps",
                "500",
                "--eval_steps",
                "200",
                "--save_steps",
                "200",
                "--output_dir",
                "models/wav2vec2-south-th-v2"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🏋️ Step 3c: Resume Training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_wav2vec2.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--output_dir",
                "models/wav2vec2-south-th-v2",
                "--resume_from_checkpoint",
                "${input:checkpointPath}"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🎮 RTX 3050 4GB: Fast Training Preset",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_wav2vec2.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--base_model",
                "airesearch/wav2vec2-large-xlsr-53-th",
                "--target",
                "text_dialect",
                "--output_dir",
                "models/wav2vec2-south-th-fast",
                "--epochs",
                "5",
                "--batch_size",
                "1",
                "--gradient_accumulation_steps",
                "8",
                "--lr",
                "1e-4",
                "--warmup_steps",
                "100",
                "--eval_steps",
                "200",
                "--save_steps",
                "200",
                "--weight_decay",
                "0.005",
                "--max_audio_seconds",
                "3.5",
                "--max_train_samples",
                "1000",
                "--num_workers",
                "0"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🎤 Step 4: Test Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/inference.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "${input:wavFilePath}",
                "--model",
                "models/wav2vec2-south-th-v2",
                "--translate"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "📦 Step 5: Export Model (zip)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/export_model.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--model_dir",
                "models/wav2vec2-south-th-v2"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "📦 Step 5: Export Model (no zip)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/export_model.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--model_dir",
                "models/wav2vec2-south-th-v2",
                "--no_zip"
            ],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "wavFilePath",
            "type": "promptString",
            "description": "Path ไฟล์ .wav",
            "default": "audio_data/south/voice_1/voice_1_1.wav"
        },
        {
            "id": "checkpointPath",
            "type": "promptString",
            "description": "Path ของ checkpoint",
            "default": "models/wav2vec2-south-th-v2/checkpoint-1000"
        }
    ]
}